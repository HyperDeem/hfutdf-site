---
import Layout from '../../layouts/Layout.astro';
import {publishedEntries,titleOf} from '../../lib/entries';
export async function getStaticPaths(){return (await publishedEntries()).filter(e=>e.data.type==='video').map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
if(entry.data.type!=='video')throw new Error('录像内容类型不正确');
const v=entry.data;
---
<Layout title={titleOf(entry)}><div class="wrap detail"><a class="breadcrumb" href="/library/videos/">← 返回比赛记录</a><div class="page-heading"><p class="eyebrow">{v.event || '赛事待考证'}</p><h1>{titleOf(entry)}</h1><p>{v.summary||v.note||''}</p></div>{v.url?<><video class="local-video" controls playsinline preload="metadata" src={v.url} aria-label={v.title}>当前浏览器无法播放此视频，请下载原文件观看。</video><p id="video-error" hidden role="status">当前浏览器无法解码这段录像，请下载原视频后使用本地播放器观看。</p></>:<div class="player-placeholder"><span class="play-symbol" aria-hidden="true">▷</span><h2>暂未接入媒体</h2><p>这里是播放器区域示意，没有真实比赛录像。</p></div>}<div class="detail-actions">{v.url?<a class="pill" href={v.url} download>下载原视频 ↓</a>:<span>暂无下载地址</span>}<p>{v.url?'下载原始录像文件。':'暂无资源地址。'}</p></div></div></Layout>
<script>
 const video=document.querySelector<HTMLVideoElement>('video');
 video?.addEventListener('error',()=>{const message=document.querySelector<HTMLElement>('#video-error');if(message)message.hidden=false;});
</script>
