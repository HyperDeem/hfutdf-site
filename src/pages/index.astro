---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import {categories} from '../data/categories';
---
<Layout><section class="hero wrap"><p class="eyebrow">思考 · 表达 · 传承</p><h1>好的思考，<br/>值得被<span>留下。</span></h1><p class="hero-copy">从一次交锋，到一份积累。<br class="mobile-only"/>让辩论的经验，继续生长。</p><a class="pill" href="#resources">探索资料 <span aria-hidden="true">↓</span></a></section>
<section id="resources" class="resources"><div class="wrap resources-wrap"><div class="section-title"><h2>从这里，找到你需要的。</h2><span>七大资料入口</span></div><div class="category-grid">{categories.map(c=><a class="category-card" href={`/library/${c.id}/`}><div class="category-top"><Icon name={c.icon}/></div><h3>{c.name}</h3><p>{c.summary}</p></a>)}</div></div></section>
<section class="film"><div class="wrap film-grid"><div><p class="eyebrow">比赛影像 / MATCH ARCHIVE</p><h2>观点会交锋。<br/>思考会留下。</h2><p>回到赛场，重新听见每一次发问。<br/>按赛事浏览，循着论证再走一遍。</p><a href="/library/videos/">查看赛事收录信息</a></div><div class="film-cover"><span class="cover-top">DEBATE / ARCHIVE <span>比赛影像</span></span><p class="archive-status">播放与下载<br/><strong>暂未开放</strong></p><span class="cover-bottom"><strong>每一场交锋，都是新的起点。</strong><span>当前仅展示赛事与录像收录信息</span></span></div></div></section>
</Layout>
