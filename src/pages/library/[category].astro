---
import Layout from '../../layouts/Layout.astro';
import EntryList from '../../components/EntryList.astro';
import {categories} from '../../data/categories';
import {publishedEntries,entryUrl,titleOf,toRow,type ContentEntry} from '../../lib/entries';
export function getStaticPaths(){return categories.map(c=>({params:{category:c.id},props:{category:c}}));}
const {category:c}=Astro.props;
const items=(await publishedEntries()).filter(e=>e.data.category_id===c.id);
const albums=items.filter(e=>e.data.type==='photo_album');
const groups=new Map<string,ContentEntry[]>();
for(const item of items){if(item.data.type==='video'){const key=item.data.event||'赛事待考证';groups.set(key,[...(groups.get(key)||[]),item]);}}
---
<Layout title={c.name}><div class="wrap library"><a class="breadcrumb" href="/#resources">资料首页</a><span class="breadcrumb"> / {c.name}</span><div class="page-heading"><p class="eyebrow">资料馆 / 模拟内容</p><h1>{c.name}</h1><p>{c.detail}</p></div><nav class="category-nav" aria-label="资料分类">{categories.map(cat=><a href={`/library/${cat.id}/`} aria-current={cat.id===c.id?'page':undefined}>{cat.name}</a>)}</nav>
{c.id==='photos'?<><div class="list-heading"><h2>主题相册</h2><span>{albums.length} 个模拟相册</span></div>{albums.length?<div class="album-grid">{albums.map(a=>a.data.type==='photo_album'&&<a class="album-card" href={entryUrl(a)}><img src={a.data.images[0].src} alt={a.data.images[0].alt}/><h3>{titleOf(a)} <span>↗</span></h3><p>{a.data.images.length} 张模拟图像</p></a>)}</div>:<EntryList items={[]}/>}</>:c.id==='videos'?(groups.size?[...groups].map(([event,items])=><section class="event-group"><div class="list-heading"><h2>{event}</h2><span>{items.length} 条模拟录像</span></div><EntryList items={items.map(toRow)}/></section>):<EntryList items={[]}/>):<><div class="list-heading"><h2>全部资料</h2><span>{items.length} 条模拟资料</span></div><EntryList items={items.map(toRow)}/></>}
<p class="page-note">仅用于体验版式与交互，以上均不代表真实收录资料。</p></div></Layout>
