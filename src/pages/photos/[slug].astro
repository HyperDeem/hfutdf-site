---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import {publishedEntries,titleOf} from '../../lib/entries';
export async function getStaticPaths(){return (await publishedEntries()).filter(e=>e.data.type==='photo_album').map(entry=>({params:{slug:entry.id},props:{entry}}));}
const {entry}=Astro.props;
if(entry.data.type!=='photo_album')throw new Error('相册内容类型不正确');
const a=entry.data;
---
<Layout title={titleOf(entry)}><div class="wrap detail"><a class="breadcrumb" href="/library/photos/">← 返回照片留影</a><div class="page-heading"><p class="eyebrow">主题相册 · {a.images.length} 张{a.demo?'模拟图像':'照片'}</p><h1>{titleOf(entry)}</h1><p>{a.summary||(a.demo?'抽象图形用于演示浏览体验，不是真实活动照片。点击图像可放大。':'点击照片可放大浏览。')}</p></div><div class="photo-grid">{a.images.map((photo,i)=><button class="photo-button" data-photo={photo.src} data-alt={photo.alt} aria-label={`放大第 ${i+1} 张${a.demo?'模拟图像':'照片'}`}><img src={photo.src} alt={photo.alt} loading="lazy"/><span>{photo.caption||`${a.demo?'模拟图像':'照片'} ${String(i+1).padStart(2,'0')}`} <span>放大 ↗</span></span></button>)}</div></div>
<dialog id="lightbox" data-label={a.demo?'模拟相册':'相册'} aria-label="相册放大预览"><div class="lightbox-toolbar"><span id="photo-count" aria-live="polite"></span><button id="photo-close" aria-label="关闭相册"><Icon name="close"/></button></div><img id="large-photo" alt="模拟抽象图形，非真实照片"/><div class="lightbox-controls"><button id="prev-photo" aria-label="上一张">←</button><span>左右方向键切换 · Esc 关闭</span><button id="next-photo" aria-label="下一张">→</button></div></dialog>
<script>
 const box=document.querySelector<HTMLDialogElement>('#lightbox')!;const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-photo]')];let index=0;
 const prev=document.querySelector<HTMLButtonElement>('#prev-photo')!, next=document.querySelector<HTMLButtonElement>('#next-photo')!;
 function update(){const image=document.querySelector<HTMLImageElement>('#large-photo')!;image.src=buttons[index].dataset.photo!;image.alt=buttons[index].dataset.alt!;document.querySelector('#photo-count')!.textContent=`${index+1} / ${buttons.length} · ${box.dataset.label}`;prev.hidden=next.hidden=buttons.length===1;}
 function move(step:number){index=(index+step+buttons.length)%buttons.length;update();}
 buttons.forEach((b,i)=>b.addEventListener('click',()=>{index=i;update();box.showModal();}));
 prev.addEventListener('click',()=>move(-1));next.addEventListener('click',()=>move(1));document.querySelector('#photo-close')!.addEventListener('click',()=>box.close());box.addEventListener('keydown',e=>{if(e.key==='ArrowLeft')move(-1);if(e.key==='ArrowRight')move(1);});
 let touchX=0;box.addEventListener('touchstart',e=>{touchX=e.changedTouches[0].clientX;},{passive:true});box.addEventListener('touchend',e=>{const delta=e.changedTouches[0].clientX-touchX;if(Math.abs(delta)>50)move(delta<0?1:-1);},{passive:true});
</script></Layout>
