---
import '../styles/global.css';
import ArchiveSearch from '../components/ArchiveSearch.astro';
import {categories} from '../data/categories';
const siteName='机械工程辩论队仓库';
const {title=siteName} = Astro.props;
const pageTitle=title===siteName?siteName:`${title} · ${siteName}`;
---
<!doctype html><html lang="zh-CN" class={Astro.url.pathname==='/'?'home-page':undefined}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content="机械工程辩论队仓库，课程、阅读、比赛与队务资料的积累与传承。"/><title>{pageTitle}</title><link rel="icon" type="image/svg+xml" href="/favicon.svg"/></head><body>
<a class="skip" href="#main">跳到正文</a>
<header><nav class="nav wrap" aria-label="主导航"><a class="brand" href="/">{siteName}</a><div class="nav-actions"><ArchiveSearch/><button class="menu-button" aria-expanded="false" aria-controls="mobile-nav" aria-label="展开导航">☰</button></div></nav><div id="mobile-nav" hidden>{categories.map(c=><a href={`/library/${c.id}/`}>{c.name}</a>)}</div></header>
<main id="main"><slot/></main>
<footer><div class="wrap">
 <div class="footer-top"><div><strong>{siteName}</strong><p>个人维护的辩论学习与资料空间，非学校或院系官方服务。</p></div><a href="/#resources">探索七大资料 →</a></div>
 <div class="footer-bottom">
  <div class="footer-contact"><span>资料投稿与联系</span><a href="mailto:1147782858@qq.com">1147782858@qq.com</a></div>
  <div class="footer-registration"><a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">皖ICP备2026037346号</a><a href="https://beian.mps.gov.cn/#/query/webSearch?code=34081102888953" rel="noopener noreferrer" target="_blank"><img src="/images/public-security-registration.png" width="18" height="20" alt=""/>皖公网安备34081102888953号</a></div>
 </div>
</div></footer>
<script>
 const menu=document.querySelector<HTMLButtonElement>('.menu-button')!; const panel=document.querySelector<HTMLElement>('#mobile-nav')!;
 menu.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));menu.setAttribute('aria-label',open?'关闭导航':'展开导航');panel.hidden=!open;});
</script>
</body></html>
