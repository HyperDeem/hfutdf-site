---
import type {EntryRow} from '../lib/entries';
const {items} = Astro.props as {items:EntryRow[]};
---
{items.length ? <ul class="resource-list">{items.map(item=><li><div class="row-copy"><h3>{item.title}</h3>{item.note && <p>{item.note}</p>}</div>{item.unavailable?<span class="row-unavailable">{item.action}</span>:item.href?<a class="row-action" href={item.href} download={item.download} target={item.external?'_blank':undefined} rel={item.external?'noopener noreferrer':undefined} aria-label={item.external?`${item.action}：${item.title}（新窗口打开）`:undefined}>{item.action}</a>:<button class="row-action" data-demo={item.title}>{item.action}</button>}</li>)}</ul>:<div class="empty"><span>暂无资料</span><p>此分类暂时没有已展示的资料。</p><a href="/#resources">浏览其他资料</a></div>}
