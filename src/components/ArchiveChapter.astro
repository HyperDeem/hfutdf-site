<section class="archive-chapter" aria-labelledby="archive-heading">
 <div class="wrap archive-layout">
  <div class="archive-intro" data-archive-reveal>
   <p class="archive-eyebrow">比赛档案 / MATCH ARCHIVE</p>
   <h2 id="archive-heading">观点会交锋。<br/>记录会留下。</h2>
   <p class="archive-description">收录历次比赛的辩题、背景说明与资料归档。当前以资料包下载为主，暂不提供站内播放。</p>
   <a class="pill archive-primary" href="/library/videos/">查看比赛记录 <span aria-hidden="true">→</span></a>
  </div>
  <article class="archive-dossier" data-archive-reveal aria-labelledby="dossier-heading">
   <p class="dossier-label">DEBATE ARCHIVE</p>
   <div class="dossier-content">
    <h3 id="dossier-heading">历次比赛记录<br/>与资料归档</h3>
    <p>包括比赛名称、辩题信息、<span class="archive-term">说明文档</span>与<span class="archive-term">压缩包下载入口</span>。</p>
   </div>
   <a class="dossier-link" href="/library/videos/">浏览归档 <span aria-hidden="true">→</span></a>
  </article>
 </div>
</section>

<style>
 .archive-chapter{background:var(--dark);color:#f5f5f7;padding:96px 0;scroll-margin-top:60px}
 .archive-layout{display:grid;grid-template-columns:1fr 1fr;gap:96px;align-items:center}
 .archive-eyebrow{font-size:13px;line-height:1.7;font-weight:600;letter-spacing:.6px;color:#c7c7cc;margin-bottom:24px}
 .archive-intro h2{font-size:46px;line-height:1.35;font-weight:600;letter-spacing:0;margin-bottom:24px}
 .archive-description{max-width:28em;font-size:17px;line-height:1.9;color:#c7c7cc;text-wrap:balance}
 .archive-primary{margin-top:30px;background:#0071e3;font-size:16px;gap:18px;padding:11px 23px}
 .archive-primary:hover{background:#0077ed}
 .archive-dossier{min-width:0;min-height:400px;border:1px solid #4c4c50;border-radius:20px;background:#2b2b2e;padding:34px 36px;display:flex;flex-direction:column}
 .dossier-label{font-size:12px;line-height:1.7;letter-spacing:1.5px;color:#c7c7cc;padding-bottom:22px;border-bottom:1px solid #4c4c50}
 .dossier-content{padding:30px 0 26px}
 .dossier-content h3{font-size:30px;line-height:1.5;font-weight:600;margin-bottom:16px}
 .dossier-content p{font-size:15px;line-height:1.9;color:#c7c7cc;text-wrap:balance}
 .archive-term{white-space:nowrap}
 .dossier-link{color:#64b5ff;display:flex;justify-content:space-between;align-items:center;gap:16px;font-size:16px;min-height:44px;padding-top:18px;border-top:1px solid #4c4c50;margin-top:auto}
 .dossier-link:hover{text-decoration:underline;text-underline-offset:5px}
 .archive-chapter a:focus-visible{outline-color:#64b5ff}
 /* Content stays visible without JS; only an active observer opts into reveal. */
 @media(prefers-reduced-motion:no-preference){
  [data-archive-reveal]{transition:opacity .6s ease,transform .6s cubic-bezier(.2,.65,.3,1)}
  .archive-dossier[data-archive-reveal]{transition-delay:.1s}
  .archive-chapter[data-reveal="pending"] [data-archive-reveal]{opacity:0;transform:translateY(16px)}
 }
 @media(max-width:1100px){.archive-layout{gap:48px}.archive-intro h2{font-size:40px}.archive-dossier{padding:30px}}
 @media(max-width:833px){
  .archive-chapter{padding:56px 0}
  .archive-layout{grid-template-columns:1fr;gap:36px}
  .archive-eyebrow{font-size:12px;margin-bottom:20px}
  .archive-intro h2{font-size:34px;line-height:1.4;margin-bottom:20px}
  .archive-description{font-size:16px;line-height:1.9}
  .archive-primary{font-size:15px;margin-top:24px}
  .archive-dossier{min-height:360px;padding:26px 24px}
  .dossier-content{padding:24px 0}
  .dossier-content h3{font-size:26px}
  .dossier-content p{font-size:15px}
  .dossier-link{font-size:15px}
 }
</style>

<script>
 const chapter=document.querySelector<HTMLElement>('.archive-chapter');
 const reducedMotion=window.matchMedia('(prefers-reduced-motion: reduce)');
 if(chapter && !reducedMotion.matches && 'IntersectionObserver' in window){
  const reveal=()=>{chapter.dataset.reveal='visible';observer.disconnect();};
  const observer=new IntersectionObserver(entries=>{
   if(entries.some(entry=>entry.isIntersecting))reveal();
  },{threshold:.12,rootMargin:'0px 0px -48px 0px'});
  chapter.dataset.reveal='pending';
  observer.observe(chapter);
  chapter.addEventListener('focusin',reveal,{once:true});
  reducedMotion.addEventListener('change',event=>{if(event.matches)reveal();});
 }
</script>
