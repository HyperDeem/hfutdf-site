---
import Layout from '../layouts/Layout.astro';
import EntryList from './EntryList.astro';
import {categories} from '../data/categories';
import {publishedEntries,entryUrl,titleOf,toRow,type ContentEntry} from '../lib/entries';
import {subcategories,type Subcategory} from '../data/subcategories';
interface Props {category: typeof categories[number]; subcategory?: Subcategory}
const {category:c,subcategory}=Astro.props;
const children=subcategory?[]:subcategories.filter(item=>item.category_id===c.id);
const title=subcategory?.name??c.name;
const items=(await publishedEntries()).filter(e=>e.data.category_id===c.id && e.data.subcategory_id===subcategory?.id);
const albums=items.filter(e=>e.data.type==='photo_album');
const downloads=(c.id==='photos'||c.id==='videos')?items.filter(e=>e.data.type==='file'):[];
const groups=new Map<string,ContentEntry[]>();
for(const item of items){if(item.data.type==='video'){const key=item.data.event||'赛事待考证';groups.set(key,[...(groups.get(key)||[]),item]);}}
---
<Layout title={title}><div class="wrap library"><nav class="breadcrumbs" aria-label="面包屑"><a href="/#resources">资料首页</a><span aria-hidden="true">/</span>{subcategory?<><a href={`/library/${c.id}/`}>{c.name}</a><span aria-hidden="true">/</span><span aria-current="page">{title}</span></>:<span aria-current="page">{c.name}</span>}</nav><div class="page-heading"><h1>{title}</h1>{!subcategory&&<p>{c.detail}</p>}</div><nav class="category-nav" aria-label="资料分类">{categories.map(cat=><a href={`/library/${cat.id}/`} aria-current={cat.id===c.id?'page':undefined}>{cat.name}</a>)}</nav>
{children.length>0&&<nav class="category-nav" aria-label="子分类">{children.map(item=><a href={`/library/${c.id}/${item.id}/`}>{item.name}</a>)}</nav>}
{c.id==='photos'?<><div class="list-heading"><h2>主题相册</h2><span>{albums.length} 个相册</span></div>{albums.length?<div class="album-grid">{albums.map(a=>a.data.type==='photo_album'&&<a class="album-card" id={`resource-${a.id}`} href={entryUrl(a)}><img src={a.data.images[0].src} alt={a.data.images[0].alt}/><h3>{titleOf(a)} <span>↗</span></h3><p>{a.data.images.length} 张{'照片'}</p></a>)}</div>:!downloads.length&&<EntryList items={[]}/>}</>:c.id==='videos'?(groups.size?[...groups].map(([event,items])=><section class="event-group"><div class="list-heading"><h2>{event}</h2><span>{items.length} 条记录</span></div><EntryList items={items.map(toRow)}/></section>):!downloads.length&&<EntryList items={[]}/>):<><div class="list-heading"><h2>{children.length?'未归入子分类的资料':'全部资料'}</h2><span>{items.length} 条资料</span></div><EntryList items={items.map(toRow)}/></>}
{downloads.length>0&&<><div class="list-heading"><h2>文件下载</h2><span>{downloads.length} 条资料</span></div><EntryList items={downloads.map(toRow)}/></>}
</div></Layout>
